
COMPOSE_PROJECT_NAME=devsecops
TZ=Asia/Kolkata

# Application source directory on the Docker host.
APP_SOURCE_HOST_PATH=./workspace

# Jenkins pipeline source selection.
SOURCE_MODE=volume
GIT_REPOSITORY=
GIT_BRANCH=main

# Local-only UI ports.
JENKINS_HTTP_PORT=8080
SONARQUBE_PORT=9000
DEFECTDOJO_PORT=8081
REDMINE_PORT=3000

# Database passwords: replace with unique, strong secrets.
SONAR_DB_PASSWORD=SomeStrongPassword1
DD_DB_PASSWORD=SomeStrongPassword2
REDMINE_DB_PASSWORD=SomeStrongPassword3

# DefectDojo application secrets.
# Generate each secret independently using: openssl rand -hex 32
DD_SECRET_KEY=e63edd0aefcc83b29b1498a1f59928d05a7a0f4093914b52b25ac41f4dbe1941
DD_CREDENTIAL_AES_256_KEY=26d3a7e33800a7c114e09a32c1fdddde63a745d4463fa264829ddacd0a56e701

# Keep Django and NGINX on the same DefectDojo release.
# Pin a verified release before deploying to production.
DEFECTDOJO_VERSION=latest

# DefectDojo initial administrator.
DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@example.com
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=User

# SonarQube.
SONAR_PROJECT_KEY=external-app
SONAR_HOST_URL=http://sonarqube:9000

# DefectDojo.
DEFECTDOJO_URL=http://defectdojo-nginx:8080
DEFECTDOJO_PRODUCT_ID=1
DEFECTDOJO_ENGAGEMENT_ID=1
DEFECTDOJO_SCAN_TYPE=Qualys Scan

# Qualys.
QUALYS_BASE_URL=https://qualysapi.qualys.com
QUALYS_REPORT_ID=

# Redmine.
REDMINE_URL=http://redmine:3000
REDMINE_PROJECT_ID=1
REDMINE_TRACKER_ID=1
REDMINE_STATUS_ID=1
REDMINE_PRIORITY_ID=2

# Optional staging URL for smoke tests.
STAGING_BASE_URL=
