# Dockerfile for the Weather-app React application.
# Used by the pipeline's "Build and Unit Tests" stage to build a container
# image that is then scanned by Trivy Image Scan and (optionally) Qualys
# QScanner.
#
# This file is copied into the app repo root at build time by the pipeline.
# If the app repo already has a Dockerfile, that takes precedence.

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --silent
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
